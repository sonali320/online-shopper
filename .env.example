# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Dataset Configuration
DATA_PATH=data/online_shoppers_intention.csv
FALLBACK_DATA_PATH=Predicting-Online-Shoppers-Purchasing-Intention-main/data/online_shoppers_intention.csv

# Output Directories
MODELS_DIR=models
REPORTS_DIR=reports

# Train / Test Splitting & Validation
TEST_SIZE=0.3
RANDOM_STATE=0
CV_FOLDS=5

# Model Optimization Modes
RUN_FULL_GRID_SEARCH=false

# Web Application Server
WEB_HOST=127.0.0.1
WEB_PORT=5000
